# Database provider. `libsql` works with both local file databases and Turso.
DB_PROVIDER=libsql

# Local development / Docker example:
DATABASE_URL=file:./data/dart-scorekeeper.db

# Turso example:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-server-side-token
DATABASE_AUTH_TOKEN=

# Optional tester feedback endpoint.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=
